# CALL-E (https://heycall-e.com) — required for REAL relay calls only.
# Server-side only. Never expose in client code or commit real keys.
CALLE_API_KEY=

# Conversation locale for unit calls (hi = Hindi). Must be a CALL-E supported locale.
CALLE_LOCALE=hi

# Unit numbers for REAL calls, E.164. For the hackathon demo, point the
# assigned unit at your own phone — exactly what CALL-E's tutorial recommends.
# Masked placeholders are used when unset; PREVIEW mode works without any of these.
UNIT_NUMBER_PCR_11=+910000000000
UNIT_NUMBER_CATS_302=+910000000000
