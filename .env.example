CALLE_API_KEY=

# Conversation locale for unit calls (hi = Hindi).
CALLE_LOCALE=hi

# REQUIRED to enable real calls on the deployed demo (fail closed without it).
# Basic operator auth per the awesome-phone-call-agents live-demo review policy.
DEMO_PIN=

# Unit numbers for REAL calls, E.164. For the hackathon demo, point the
# assigned unit at your own phone. Masked placeholders used when unset.
UNIT_NUMBER_PCR_11=+910000000000
UNIT_NUMBER_CATS_302=+910000000000
