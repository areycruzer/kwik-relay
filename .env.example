# AI triage — primary provider: GLM (BigModel) free tier
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5-flash
LLM_TIMEOUT_MS=45000

# AI triage — optional OpenAI-compatible fallback.
# Used automatically when GLM_API_KEY is absent. Force either provider with
# LLM_PROVIDER=glm | openai (default auto: GLM first, OpenAI fallback).
# LLM_PROVIDER=auto
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible gateway works via the base URL.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Hume voice and emotion analysis
HUME_API_KEY=your_hume_api_key_here
HUME_SECRET_KEY=your_hume_secret_key_here
NEXT_PUBLIC_HUME_CONFIG_ID=your_hume_config_id_here

# Optional: live transcription
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional: server logging
LOG_LEVEL=info

# CALL-E demo call (the live demo-call leg; server-side only)
CALLE_API_KEY=
DEMO_PIN=
TESTER_NUMBER=+910000000000
